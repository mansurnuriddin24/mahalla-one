# ========================================================
# MAHALLA ONE — PRODUCTION ENVIRONMENT VARIABLES
# ========================================================

# 1. SERVER & PORT
PORT="3000"
NODE_ENV="production"

# 2. APPLICATION DOMAIN / URL (HTTPS talab qilinadi)
# Telegram Webhook va Mini App ishlashi uchun to'liq HTTPS domen (oxirida / bo'lmasin):
# Masalan: https://mahalla-one.uz yoki https://your-app.railway.app
APP_URL="https://your-domain.uz"

# 3. DATABASE (PostgreSQL)
# Variant A: Bitta to'liq ulanish havolasi (Neon, Supabase, Railway, Render yoki Cloud SQL):
DATABASE_URL="postgres://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Variant B: Alohida parametrlar (agar DATABASE_URL berilmagan bo'lsa):
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="your_secure_password"
SQL_DB_NAME="mahalla_one"
SQL_PORT="5432"
SQL_SSL="true"

# 4. TELEGRAM BOT INTEGRATION
# @BotFather dan olingan bot tokeni (masalan: 8645068412:AAH...):
TELEGRAM_BOT_TOKEN="9293033646:AAEVpbeh-3HNBgUhyqoqqcwI-WqZA36HLF8"

# Telegram webhook xavfsizlik maxfiy tokeni (ixtiyoriy, 1-256 ta belgi):
TELEGRAM_WEBHOOK_SECRET="mahalla_one_webhook_secret_2026"

# 5. SUPER ADMINISTRATOR HUQUQI (Telegram ID)
# Asosiy Super Admin Telegram ID raqami (buni Telegramda @userinfobot orqali olish mumkin):
SUPER_ADMIN_TELEGRAM_ID="5564730141"
# Qo'shimcha super adminlar (ixtiyoriy, vergul bilan):
SUPER_ADMIN_TELEGRAM_IDS="5564730141,1000001"

# 6. GEMINI AI (Ixtiyoriy - AI murojaat tahlili uchun)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
